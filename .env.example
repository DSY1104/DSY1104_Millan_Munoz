# LUNARi Frontend Environment Variables

# Microservices API URLs
# Usuario Service - Authentication, user management, points, coupons
VITE_USUARIO_API_URL=http://localhost:8081/api/v1

# Inventario Service - Product catalog and categories
VITE_INVENTARIO_API_URL=http://localhost:8082/api/v1

# Carrito Service - Shopping cart, checkout, orders, payments
VITE_CARRITO_API_URL=http://localhost:8083/api/v1

# Application Settings
VITE_APP_NAME=LUNARi
VITE_APP_ENV=development
